rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Media per restaurant: publiek leesbaar (voor de app),
    // alleen de eigenaar mag uploaden/wijzigen in zijn eigen map.
    match /restaurants/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 50 * 1024 * 1024; // max 50MB per bestand
    }
  }
}
