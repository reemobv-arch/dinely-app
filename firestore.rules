rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Super-admins: mogen alles lezen en aanpassen (zie lib/admins.ts).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['reemobv@gmail.com', 'hello@dinely.nl'];
    }

    // Restaurants: iedereen mag lezen (de app toont ze),
    // alleen de eigenaar (of een admin) mag schrijven.
    match /restaurants/{uid} {
      allow read: if true;
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    // Deals: publiek leesbaar; eigenaar of admin mag aanmaken/wijzigen.
    match /deals/{dealId} {
      allow read: if true;
      allow write: if isAdmin() || (request.auth != null
        && (request.resource.data.owner == request.auth.uid
            || resource.data.owner == request.auth.uid));
    }

    // Sollicitaties: het restaurant (eigenaar) of een admin mag ze lezen en beheren.
    match /applications/{appId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.restaurantId == request.auth.uid)
        || (request.auth != null && resource.data.creatorUid == request.auth.uid);
      // Een creator mag alleen solliciteren als die goedgekeurd is (approved).
      allow create: if isAdmin()
        || (request.auth != null && request.resource.data.restaurantId == request.auth.uid)
        || (request.auth != null && request.resource.data.creatorUid == request.auth.uid
            && exists(/databases/$(database)/documents/creators/$(request.auth.uid))
            && get(/databases/$(database)/documents/creators/$(request.auth.uid)).data.status == 'approved');
      allow update: if isAdmin()
        || (request.auth != null && resource.data.restaurantId == request.auth.uid)
        || (request.auth != null && resource.data.creatorUid == request.auth.uid);
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.restaurantId == request.auth.uid);
    }

    // Reviews: publiek leesbaar; eigenaar/admin OF de creator die er at mag aanmaken.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAdmin()
        || (request.auth != null && request.resource.data.restaurantId == request.auth.uid)
        || (request.auth != null && request.resource.data.creatorUid == request.auth.uid);
      allow update, delete: if isAdmin()
        || (request.auth != null && resource.data.restaurantId == request.auth.uid);
    }

    // Creators (aanmeldingen): admin en de creator zelf mogen lezen. De creator
    // maakt/werkt z'n eigen profiel bij (status blijft dan gelijk); alleen een
    // admin mag de status wijzigen (goedkeuren/afwijzen).
    match /creators/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    // Content (foto's/video van creators): publiek leesbaar; de creator maakt
    // z'n eigen content aan, restaurant/admin mag verwijderen (moderatie).
    match /content/{contentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.creatorUid == request.auth.uid;
      allow update, delete: if isAdmin()
        || (request.auth != null && resource.data.creatorUid == request.auth.uid)
        || (request.auth != null && resource.data.restaurantId == request.auth.uid);
    }

    // Publieke creator-directory: elke ingelogde gebruiker (restaurants) mag lezen;
    // alleen de creator zelf of een admin schrijft. Bevat geen telefoon/IBAN.
    match /creatorProfiles/{uid} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    // Uitnodigingen: een restaurant stuurt een deal naar een creator.
    match /invites/{inviteId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.creatorUid == request.auth.uid)
        || (request.auth != null && resource.data.restaurantId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.restaurantId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Deel-links: publiek leesbaar (het gast-scherm toont ze), alleen het restaurant
    // (of admin) maakt/beheert ze. De code is de document-id.
    match /links/{code} {
      allow read: if true;
      allow create, update: if isAdmin()
        || (request.auth != null && request.resource.data.restaurantId == request.auth.uid);
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.restaurantId == request.auth.uid);
    }

    // Reserveringen: een gast (zonder login) mag er één achterlaten, mits de deel-link
    // bestaat en het restaurant overeenkomt. Lezen mag het restaurant, de creator of admin.
    match /reservations/{id} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.restaurantId == request.auth.uid)
        || (request.auth != null && resource.data.creatorUid == request.auth.uid);
      allow create: if request.resource.data.keys().hasAll(
            ['restaurantId', 'dealId', 'creatorUid', 'linkCode', 'naam', 'aantal'])
        && exists(/databases/$(database)/documents/links/$(request.resource.data.linkCode))
        && get(/databases/$(database)/documents/links/$(request.resource.data.linkCode)).data.restaurantId
             == request.resource.data.restaurantId;
      allow update, delete: if isAdmin();
    }
  }
}
